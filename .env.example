# ---- Сервер ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ---- Дерекқор ----
DB_DRIVER=sqlite
SQLITE_FILE=./server/database/data/game.db
# PostgreSQL қолдану үшін:
# DB_DRIVER=postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/kzhistory

# ---- Қауіпсіздік ----
JWT_SECRET=change-this-to-a-long-random-string
BCRYPT_ROUNDS=12
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# ---- Админ ----
ADMIN_PASSWORD=Akilbek8080

# ---- Ойын ----
MAX_ATTEMPTS=3
HEARTS_PER_ROOM=5
BONUS_PERFECT_HEARTS=5
BONUS_ALL_CORRECT=10

# ---- Google Sheets (OPTIONAL) ----
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
