{
  "name": "kz-history-rpg",
  "version": "1.0.0",
  "description": "Қазақстан тарихы пәніне арналған интерактивті RPG ойын-сайты (Phaser 3 + Express + SQLite/PostgreSQL)",
  "main": "server/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node tools/build.js",
    "test": "node tests/flow.test.js && node tests/client.test.mjs",
    "audio": "python3 tools/generate-audio.py",
    "db:reset": "node tools/reset-db.js",
    "postinstall": "node -e \"require('fs').existsSync('.env')||require('fs').copyFileSync('.env.example','.env')\"",
    "test:server": "node tests/flow.test.js",
    "test:client": "node tests/client.test.mjs"
  },
  "keywords": [
    "kazakhstan-history",
    "education",
    "rpg",
    "phaser3",
    "quiz",
    "pdf-parser",
    "express"
  ],
  "author": "Ақылбек Беделханұлы",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "express-validator": "^7.2.1",
    "googleapis": "^165.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pdfjs-dist": "4.2.67",
    "pdfkit": "^0.17.2",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jsdom": "^28.0.0"
  }
}
